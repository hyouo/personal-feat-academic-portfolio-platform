# Copy to backend/.env and set both required values. Never commit backend/.env.
ADMIN_PASSWORD=
# Generate a random secret, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3001
# Optional absolute paths; defaults stay inside backend/.
# PORTFOLIO_DB_PATH=/absolute/path/to/portfolio.db
# PORTFOLIO_UPLOAD_DIR=/absolute/path/to/uploads
